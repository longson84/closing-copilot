{
  "name": "closing-copilot",
  "version": "1.0.0",
  "description": "AI closing copilot for Singapore new-launch property agents",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite web",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "dev:web:mock": "VITE_MOCK=1 vite web",
    "build:web": "vite build web",
    "typecheck:web": "tsc --noEmit -p web"
  },
  "packageManager": "pnpm@10.30.2",
  "dependencies": {
    "@google-cloud/documentai": "^10.2.0",
    "@google-cloud/firestore": "^9.3.1",
    "@google/adk": "2.3.0",
    "@google/genai": "^2.30.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@google/adk-devtools": "2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
